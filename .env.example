POSTGRES_DB=laluan
POSTGRES_USER=laluan
POSTGRES_PASSWORD=laluan_dev
# Blank uses local development files. For PostgreSQL use the URL below.
# DATABASE_URL=postgresql://laluan:laluan_dev@localhost:5432/laluan
DATABASE_URL=

API_PORT=4000
API_HOST=127.0.0.1
WEB_ORIGIN=http://localhost:5173
NLP_API_URL=http://localhost:8000
# Optional absolute path to a reviewed catalogue JSON file.
CATALOGUE_PATH=

SENTENCE_TRANSFORMER_MODEL=sentence-transformers/all-MiniLM-L6-v2
ENABLE_EMBEDDINGS=true
SIMILARITY_THRESHOLD=0.55

GEMINI_API_KEY=
# Choose a model available to your project in Google AI Studio.
GEMINI_MODEL=

AUTH_REQUIRED=false
FIREBASE_PROJECT_ID=cat304-89545
# Private local path: each developer supplies an authorised JSON file.
GOOGLE_APPLICATION_CREDENTIALS=

VITE_API_URL=http://localhost:4000
# Shared CAT304 web configuration. This identifies the frontend project;
# it is not an Admin SDK credential or a Gemini API key.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
