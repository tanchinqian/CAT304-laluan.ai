{
  "name": "laluan-ai",
  "private": true,
  "workspaces": [
    "apps/web",
    "services/api"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "test": "node --test services/api/test/*.test.js",
    "test:browser": "node scripts/validate-browser.cjs",
    "dev:web": "npm run dev --workspace @laluan/web",
    "build:web": "npm run build --workspace @laluan/web",
    "dev:api": "npm run dev --workspace @laluan/api",
    "start:api": "npm run start --workspace @laluan/api"
  },
  "engines": {
    "node": ">=24.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1"
  }
}
